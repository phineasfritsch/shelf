# Shelf - every environment variable, with its default. Everything is optional except that
# you almost certainly want to set a password (otherwise one is generated and printed on
# first boot and its hash is stored in DATA_DIR/password.hash).
#
# All lines are commented out: uncomment what you want to change. Values are read as-is
# (no quotes needed). Use with:
#   node --env-file=.env server.js
#   docker run --env-file .env ...           (values taken literally)
#   docker compose --env-file .env ...       (Compose interpolates "$": write "$$" for a literal
#                                             dollar in PASSWORD_HASH, or use PASSWORD_FILE)

# ---------- Network ----------
# Listen port.
#PORT=8080
# Listen address. Keep 0.0.0.0 in Docker (the HEALTHCHECK connects to 127.0.0.1).
#HOST=0.0.0.0

# ---------- Storage ----------
# The single persistent directory: shelf.db (+ -wal/-shm), files/, tmp/, text.txt, password.hash.
# Must be a local filesystem (SQLite) and writable by the process (uid 1000 in Docker).
#DATA_DIR=/data

# ---------- Password (resolution order: PASSWORD_HASH → PASSWORD_FILE → PASSWORD → DATA_DIR/password.hash → generate) ----------
# Preferred. scrypt$32768$8$1$<salt>$<key> from `npm run -s hash-password` or
# `docker run --rm -i shelf node scripts/hash-password.mjs`. No default.
#PASSWORD_HASH=
# Path to a file (Docker/Compose secrets). Trimmed contents are a hash if they start with
# "scrypt$", otherwise the plaintext password. No default.
#PASSWORD_FILE=
# Plaintext convenience. Hashed in memory at boot, then removed from the environment;
# logs a warning suggesting PASSWORD_HASH. No default.
#PASSWORD=

# ---------- Sessions and cookies ----------
# Sliding session lifetime in days; a device used at least once per period is never logged out.
#SESSION_DAYS=365
# auto = the cookie gets "Secure" when the request is HTTPS (TLS socket or X-Forwarded-Proto: https);
# true/false force it. Forcing true on plain http:// causes a login loop.
#COOKIE_SECURE=auto
# 1 = trust X-Forwarded-For (rightmost entry = client IP) and X-Forwarded-Host from the proxy
# in front of Shelf. Leave 0 when browsers reach Shelf directly.
#TRUST_PROXY=0
# Comma-separated full origins (https://shelf.example.com) accepted by the CSRF/WebSocket Origin
# check in addition to the request's own host. Only needed if a proxy rewrites Host and you
# cannot set TRUST_PROXY=1. No default.
#ALLOWED_ORIGINS=

# ---------- Files ----------
# Default lifetime of an uploaded file in hours (decimals allowed). 0 = never expire.
# "Keep" on a file exempts it from expiry.
#FILE_TTL_HOURS=168
# Per-file upload cap in MB (HTTP 413 above it). Your reverse proxy must allow bodies this large.
#MAX_FILE_MB=2048
# Total cap for all stored files in MB (HTTP 507 when full). 0 = unlimited.
#MAX_STORAGE_MB=0
# Text box cap in KB, enforced by the client (the server sends it in the handshake).
#MAX_TEXT_KB=2048
# How often (seconds) expired files, stale sessions, login attempts and link tokens are swept.
#SWEEP_INTERVAL_SEC=60

# ---------- Login rate limiting (per client IP, persisted across restarts) ----------
# Failed attempts within the window before HTTP 429 with Retry-After.
#LOGIN_MAX_FAILS=5
# Sliding window in minutes for the above.
#LOGIN_WINDOW_MIN=15

# ---------- Process ----------
# Seconds to wait for in-flight uploads on SIGTERM/SIGINT before exiting anyway.
#SHUTDOWN_TIMEOUT_SEC=20
# Name shown in the page title and returned by GET /api/me (max 40 chars).
#APP_NAME=Shelf
# 1 = JSON lines on stdout instead of text lines.
#LOG_JSON=0
